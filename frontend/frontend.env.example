# ตัวอย่าง config สำหรับพัฒนาบนเครื่อง
FRONTEND_PORT=3000

# เว้นว่าง = เบราว์เซอร์เรียก /api บน Next แล้ว proxy ไป Go
NEXT_PUBLIC_API_URL=

# สำคัญ: ชี้ไป API บนเครื่อง (อย่าเว้นว่าง — ค่าว่างจะไม่ไป Cloud Run ที่ถูกระงับแล้ว)
API_PROXY_TARGET=http://127.0.0.1:8080

NEXT_PUBLIC_DEMO_LOGIN=true
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

NEXT_PUBLIC_TEACHABLE_MACHINE_MODEL_URL=/models/ecobin-bottle-can/
NEXT_PUBLIC_TEACHABLE_MACHINE_CONFIDENCE=0.80
