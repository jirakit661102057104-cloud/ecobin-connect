# Vercel production example
# เว้น NEXT_PUBLIC_API_URL ว่าง = เบราว์เซอร์เรียก same-origin /api
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DEMO_LOGIN=false

# Cloud Run ถูกระงับแล้ว — อย่าใส่ URL เก่า
# เมื่อมี API ออนไลน์ใหม่ค่อยตั้งใน Vercel Dashboard:
#   API_PROXY_TARGET=https://your-new-api.example.com
# อย่าใส่ localhost

NEXT_PUBLIC_TEACHABLE_MACHINE_MODEL_URL=/models/ecobin-bottle-can/
NEXT_PUBLIC_TEACHABLE_MACHINE_CONFIDENCE=0.80
