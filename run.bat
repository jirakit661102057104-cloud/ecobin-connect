@echo off
setlocal EnableExtensions EnableDelayedExpansion
cd /d "%~dp0"
set "ECOBIN_ROOT=%CD%"

REM Usage:  run.bat         -> local MariaDB (backend\backend.env)
REM         run.bat tidb    -> TiDB Cloud    (backend\backend.env.tidb)
set "DB_MODE=local"
if /I "%~1"=="tidb" set "DB_MODE=tidb"
set "ECOBIN_ENV_FILE="
if "%DB_MODE%"=="tidb" (
  if not exist "%ECOBIN_ROOT%\backend\backend.env.tidb" (
    echo !!! Missing backend\backend.env.tidb
    echo     Copy backend\backend.env.tidb.example and put your TiDB password in MYSQL_DSN
    pause
    exit /b 1
  )
  set "ECOBIN_ENV_FILE=%ECOBIN_ROOT%\backend\backend.env.tidb"
)

echo ============================================
echo  PCRU CFO SAVEPOINT - LOCAL
if "%DB_MODE%"=="tidb" (
  echo  TiDB Cloud + Go API + Next.js
) else (
  echo  MariaDB + Go API + Next.js
)
echo ============================================
echo.

call :loadenv "%ECOBIN_ROOT%\backend\backend.env"
if "%DB_MODE%"=="tidb" call :loadenv "%ECOBIN_ROOT%\backend\backend.env.tidb"
call :loadenv "%ECOBIN_ROOT%\frontend\frontend.env"
if not defined API_PORT set "API_PORT=8080"
if not defined FRONTEND_PORT set "FRONTEND_PORT=3000"
set "API_PROXY_TARGET=http://127.0.0.1:%API_PORT%"

if not exist "%ECOBIN_ROOT%\logs" mkdir "%ECOBIN_ROOT%\logs"
set "BACKEND_LOG=%ECOBIN_ROOT%\logs\backend.log"
set "API_EXE=%ECOBIN_ROOT%\logs\ecobin-api.exe"

where go >nul 2>&1
if errorlevel 1 (
  echo !!! ไม่พบคำสั่ง go — ติดตั้ง Go แล้วเปิด terminal ใหม่
  pause
  exit /b 1
)

echo [1/6] Free ports %FRONTEND_PORT% and %API_PORT% ...
call :killport %FRONTEND_PORT%
call :killport %API_PORT%
timeout /t 2 /nobreak >nul

if "%DB_MODE%"=="tidb" (
  echo [2/6] Using TiDB Cloud - skip local MariaDB
  echo       Config: backend\backend.env.tidb
  goto after_db
)
echo [2/6] Start local MariaDB on 127.0.0.1:3306 ...
call :start_mariadb
if errorlevel 1 (
  echo !!! MariaDB start failed
  pause
  exit /b 1
)
:after_db

echo [3/6] Write frontend\.env.local for LOCAL API ...
(
  echo # Auto-generated by run.bat - local only
  echo FRONTEND_PORT=%FRONTEND_PORT%
  echo NEXT_PUBLIC_API_URL=
  echo API_PROXY_TARGET=http://127.0.0.1:%API_PORT%
  echo NEXT_PUBLIC_DEMO_LOGIN=true
  echo NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
  echo NEXT_PUBLIC_GOOGLE_CLIENT_ID=%NEXT_PUBLIC_GOOGLE_CLIENT_ID%
  echo NEXT_PUBLIC_TEACHABLE_MACHINE_MODEL_URL=/models/ecobin-bottle-can/
  echo NEXT_PUBLIC_TEACHABLE_MACHINE_CONFIDENCE=0.80
) > "%ECOBIN_ROOT%\frontend\.env.local"
echo       API_PROXY_TARGET=http://127.0.0.1:%API_PORT%

if not exist "%ECOBIN_ROOT%\frontend\node_modules\" (
  echo       npm install ...
  pushd "%ECOBIN_ROOT%\frontend"
  call npm install
  if errorlevel 1 (
    echo !!! npm install failed
    popd
    pause
    exit /b 1
  )
  popd
)

echo [4/6] Build Go API ...
pushd "%ECOBIN_ROOT%\backend"
go build -o "%API_EXE%" .
if errorlevel 1 (
  echo !!! go build failed
  popd
  pause
  exit /b 1
)
popd
echo       Built: logs\ecobin-api.exe

echo [5/6] Start Go API on port %API_PORT% (separate window, auto-restart) ...
echo.>> "%BACKEND_LOG%"
echo ===== backend start %DATE% %TIME% =====>> "%BACKEND_LOG%"

REM Separate console + restart loop so Ctrl+C on Next.js does not kill the API forever
(
  echo @echo off
  echo title PCRU-API :%API_PORT%
  echo cd /d "%ECOBIN_ROOT%\backend"
  echo :loop
  echo echo [%%DATE%% %%TIME%%] starting API...^>^> "%BACKEND_LOG%"
  echo "%API_EXE%" ^>^> "%BACKEND_LOG%" 2^>^&1
  echo echo [%%DATE%% %%TIME%%] API exited ^^!ERRORLEVEL^^! — restart in 2s^>^> "%BACKEND_LOG%"
  echo timeout /t 2 /nobreak ^>nul
  echo goto loop
) > "%ECOBIN_ROOT%\logs\_start_api.bat"

start "PCRU-API" /MIN cmd /k "%ECOBIN_ROOT%\logs\_start_api.bat"

echo       Waiting for http://127.0.0.1:%API_PORT%/health ...
set "BACKEND_OK=0"
for /L %%i in (1,1,90) do (
  powershell -NoProfile -Command "try { $r = Invoke-WebRequest -UseBasicParsing -TimeoutSec 2 http://127.0.0.1:%API_PORT%/health; if ($r.StatusCode -eq 200) { exit 0 } else { exit 1 } } catch { exit 1 }" >nul 2>&1
  if not errorlevel 1 (
    set "BACKEND_OK=1"
    echo       Backend READY.
    goto after_wait_api
  )
  timeout /t 1 /nobreak >nul
)

:after_wait_api
if "%BACKEND_OK%"=="0" (
  echo.
  echo !!! Backend NOT healthy - frontend will NOT start
  echo     Last lines of logs\backend.log:
  echo --------------------------------------------
  powershell -NoProfile -Command "if (Test-Path '%BACKEND_LOG%') { Get-Content '%BACKEND_LOG%' -Tail 40 }"
  echo --------------------------------------------
  echo     Tip: open logs\_start_api.bat window or run:  cd backend ^& go run .
  pause
  exit /b 1
)

echo [6/6] Start Next.js on port %FRONTEND_PORT% ...
echo.
echo ============================================
echo  Open:      http://localhost:%FRONTEND_PORT%/
echo  Login:     http://localhost:%FRONTEND_PORT%/login
echo  API:       http://127.0.0.1:%API_PORT%/health
if "%DB_MODE%"=="tidb" (
  echo  DB:        TiDB Cloud ecobin-prod / ecobin
) else (
  echo  DB:        MariaDB 127.0.0.1:3306 / ecobin
)
echo.
echo  Demo Admin: st661102057104@gmail.com / ecobin123
echo  Stop:       Ctrl+C  (แล้วจะปิด API ด้วย)
echo  อย่าปิดหน้าต่าง PCRU-API ที่ minimize
echo ============================================
echo.

start "" "http://localhost:%FRONTEND_PORT%/"

pushd "%ECOBIN_ROOT%\frontend"
set "API_PROXY_TARGET=http://127.0.0.1:%API_PORT%"
set "NEXT_PUBLIC_DEMO_LOGIN=true"
call npx next dev --port %FRONTEND_PORT%
set "NEXT_EXIT=!ERRORLEVEL!"
popd

echo.
echo Frontend stopped. Stopping Go API ...
REM Close auto-restart window + free port
taskkill /FI "WINDOWTITLE eq PCRU-API*" /F >nul 2>&1
taskkill /FI "IMAGENAME eq ecobin-api.exe" /F >nul 2>&1
call :killport %API_PORT%
exit /b %NEXT_EXIT%

goto :eof

:loadenv
if not exist "%~1" goto :eof
for /f "usebackq eol=# tokens=1,* delims==" %%A in ("%~1") do (
  if not "%%A"=="" set "%%A=%%B"
)
goto :eof

:killport
set "PORT=%~1"
echo   - kill port %PORT%
for /f "tokens=5" %%P in ('netstat -ano ^| findstr /R /C:":%PORT% .*LISTENING"') do (
  if not "%%P"=="0" if not "%%P"=="" taskkill /F /PID %%P >nul 2>&1
)
goto :eof

:start_mariadb
set "MYSQLD=C:\Program Files\MariaDB 13.0\bin\mysqld.exe"
set "DEFAULTS=D:\ecobin-mariadb\my.ini"

netstat -an | findstr ":3306" | findstr LISTENING >nul
if not errorlevel 1 (
  echo       MariaDB already up on 3306
  exit /b 0
)

if not exist "%MYSQLD%" (
  echo       MariaDB not found: %MYSQLD%
  echo       Install: winget install -e --id MariaDB.Server
  exit /b 1
)
if not exist "%DEFAULTS%" (
  echo       Missing %DEFAULTS%
  exit /b 1
)

echo       Starting mysqld ...
start "EcoBin-MariaDB" /MIN "%MYSQLD%" --defaults-file="%DEFAULTS%" --console
for /L %%i in (1,1,25) do (
  netstat -an | findstr ":3306" | findstr LISTENING >nul
  if not errorlevel 1 (
    echo       MariaDB READY
    exit /b 0
  )
  timeout /t 1 /nobreak >nul
)
echo       MariaDB failed to listen on 3306
exit /b 1
