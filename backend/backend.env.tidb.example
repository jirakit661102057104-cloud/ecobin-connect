# PCRU CFO SAVEPOINT — TiDB Cloud Starter (free), instance ecobin-prod, AWS Singapore (ap-southeast-1)
# Copy to backend.env.tidb and replace YOUR_PASSWORD (TiDB Console → Connect → Generate Password).
# Run with:  ECOBIN_ENV_FILE=backend.env.tidb  (backend.env.tidb is gitignored)
APP_ENV=development
SEED_DEMO=true
WASTE_AUTO_APPROVE=true
COOKIE_SECURE=false

API_PORT=8080
CORS_ORIGIN=http://localhost:3000

# TiDB requires TLS (tls=true uses the system CA store) and listens on port 4000.
MYSQL_DSN=YOUR_TIDB_USER:YOUR_PASSWORD@tcp(gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000)/ecobin?tls=true&parseTime=true&charset=utf8mb4&loc=Local

JWT_SECRET=change-me-to-a-long-random-string
UPLOAD_DIR=uploads
GOOGLE_AUTH_ENABLED=false
OTP_DEBUG=true
